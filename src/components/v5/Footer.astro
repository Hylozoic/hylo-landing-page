---
// Source: design_handoff_v5/design/shared.jsx (Footer)
// Centered logo + tagline above a 4-column menu. Static — no JS needed.
//
// Item shapes match Nav.jsx:
//   'Plain text'                            → no link, just text
//   { t: 'Label', href: '/path' }           → internal navigation
//   { t: 'Label', ext: true, href?: '...' } → external (renders the ↗ icon)

const COLUMNS = [
  {
    h: 'About Hylo',
    l: [
      { t: 'About Hylo',         href: '/about'   },
      { t: 'Community stories',  href: '/stories' },
      { t: 'Hylo’s Stewardship', href: '/about'   },
      { t: 'Team',               href: '/about'   },
    ],
  },
  {
    h: 'Using Hylo',
    l: [
      { t: 'Features',             href: '/features'            },
      { t: 'Pricing',              href: '/pricing'             },
      { t: 'Stewardship support',  href: '/stewardship-support' },
      { t: 'Member Guide',         ext: true, href: 'https://hylozoic.gitbook.io/hylo/guides/hylo-user-guide'      },
      { t: 'Steward Guide',        ext: true, href: 'https://hylozoic.gitbook.io/hylo/guides/onboarding-your-group' },
      { t: 'Documentation',        ext: true, href: 'https://hylozoic.gitbook.io/hylo'                            },
      { t: 'Code',                 ext: true, href: 'https://github.com/hylozoic'                                 },
    ],
  },
  {
    h: 'Participate',
    l: [
      { t: 'Get involved',  href: '/get-involved' },
      { t: 'Blog',          href: '/blog'         },
      { t: 'Who is it for', href: '/who-is-hylo-for' },
      { t: 'Join our open-source community', href: '/get-involved#builders' },
      { t: 'Attend a community call',        ext: true, href: 'https://luma.com/calendar/cal-neuN1NsBDApQ8Cb' },
      { t: 'Partner with us',                href: '/get-involved#partner' },
      { t: 'Contribute to Hylo',             ext: true, href: 'https://opencollective.com/hylo' },
    ],
  },
  {
    h: 'Agreements',
    l: [
      { t: 'Hylo Values',              href: '/agreements#values'     },
      { t: 'Code of Conduct',          href: '/agreements#conduct'    },
      { t: 'Hylo Platform Agreements', href: '/agreements#agreements' },
      { t: 'Terms of Use',             href: '/terms'                 },
      { t: 'Privacy Policy',           href: '/privacy'               },
    ],
  },
];
---

<footer class="footer">
  <div class="intro">
    <img src="/v5/hylo-logo-dark.svg" alt="Hylo" class="logo" />
    <p class="tagline">
      A commons-owned platform for groups that want to build trust, coordinate
      action, and grow together.
    </p>
  </div>

  <div class="cols">
    {COLUMNS.map((col) => (
      <div>
        <div class="colHead">{col.h}</div>
        {col.l.map((x) => {
          const label = typeof x === 'string' ? x : x.t;
          const ext   = typeof x === 'object' && x.ext;
          const href  = typeof x === 'object' ? x.href : undefined;
          const Tag   = href ? 'a' : 'div';
          return (
            <Tag
              class="link"
              href={href}
              target={ext && href ? '_blank' : undefined}
              rel={ext && href ? 'noopener noreferrer' : undefined}
            >
              <span>{label}</span>
              {ext && (
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor"
                  stroke-width="1.3" style="opacity: 0.5; flex: none;" aria-hidden="true">
                  <path d="M3 7L7 3" />
                  <path d="M4 3h3v3" />
                </svg>
              )}
            </Tag>
          );
        })}
      </div>
    ))}
  </div>

  <div class="bottom">
    <div>Built with care by <a href="https://www.terran.io/" target="_blank" rel="noopener noreferrer">Terran Collective</a> &middot; Open source &middot; Apache 2.0 License</div>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/v5/tokens' as *;

  .footer {
    background: #fff;
    border-top: 1px solid $athens-dark;
    padding: 56px 60px 40px;
    font-family: $font-sans;
    color: $ink;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 56px;
  }

  .logo {
    height: 40px;
    display: block;
  }

  .tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba($ink, 0.7);
    max-width: 480px;
    margin: 18px 0 0;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }

  .colHead {
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: rgba($ink, 0.6);
    margin-bottom: 14px;
  }

  .link {
    font-size: 13.5px;
    margin-bottom: 10px;
    color: $ink;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    // Some links render as <a> when they have href; strip default styling
    // so they look identical to the unlinked <div> variant.
    text-decoration: none;
  }
  a.link:hover { text-decoration: underline; }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid $athens-dark;
    font-size: 12.5px;
    color: rgba($ink, 0.6);
    flex-wrap: wrap;
    gap: 16px;
  }

  .social {
    display: flex;
    gap: 20px;
  }

  // ── Tablet portrait and below ────────────────────────────────
  @media (max-width: 880px) {
    .footer { padding: 48px 24px 32px; }
    .cols { grid-template-columns: 1fr 1fr; gap: 32px; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 480px) {
    .cols { grid-template-columns: 1fr; gap: 28px; }
    .social { flex-wrap: wrap; gap: 12px 20px; }
  }
</style>
