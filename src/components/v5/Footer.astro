---
// Source: design_handoff_v5/design/shared.jsx (Footer)
// Centered logo + tagline above a 4-column menu. Static — no JS needed.

const COLUMNS = [
  {
    h: 'About Hylo',
    l: [
      'Our Purpose & Vision',
      'How We Work: Participatory Design',
      'Hylo’s Stewardship',
      'Team',
    ],
  },
  {
    h: 'Using Hylo',
    l: [
      { t: 'Member Guide', ext: true },
      { t: 'Steward Guide', ext: true },
      { t: 'Documentation', ext: true },
      { t: 'Community Stewardship Support', ext: true },
      { t: 'Code', ext: true },
    ],
  },
  {
    h: 'Participate',
    l: [
      'Join our open-source community',
      'Attend a community call',
      'Partner with us',
      'Contribute to Hylo',
    ],
  },
  {
    h: 'Agreements',
    l: [
      'Hylo Values',
      'Code of Conduct',
      'Hylo Platform Agreements',
      'Terms of Use',
      'Privacy Policy',
    ],
  },
];
---

<footer class="footer">
  <div class="intro">
    <img src="/v5/hylo-logo-dark.svg" alt="Hylo" class="logo" />
    <p class="tagline">
      A commons-owned platform for groups that want to build trust, coordinate
      real work, and grow together.
    </p>
  </div>

  <div class="cols">
    {COLUMNS.map((col) => (
      <div>
        <div class="colHead">{col.h}</div>
        {col.l.map((x) => {
          const label = typeof x === 'string' ? x : x.t;
          const ext = typeof x === 'object' && x.ext;
          return (
            <div class="link">
              <span>{label}</span>
              {ext && (
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor"
                  stroke-width="1.3" style="opacity: 0.5; flex: none;" aria-hidden="true">
                  <path d="M3 7L7 3" />
                  <path d="M4 3h3v3" />
                </svg>
              )}
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <div class="bottom">
    <div>Built with care by Terran Collective &middot; Open source &middot; MIT License</div>
    <div class="social">
      <span>GitHub</span>
      <span>Mastodon</span>
      <span>Bluesky</span>
      <span>Newsletter</span>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/v5/tokens' as *;

  .footer {
    background: #fff;
    border-top: 1px solid $athens-dark;
    padding: 56px 60px 40px;
    font-family: $font-sans;
    color: $ink;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 56px;
  }

  .logo {
    height: 40px;
    display: block;
  }

  .tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba($ink, 0.7);
    max-width: 480px;
    margin: 18px 0 0;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }

  .colHead {
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: rgba($ink, 0.6);
    margin-bottom: 14px;
  }

  .link {
    font-size: 13.5px;
    margin-bottom: 10px;
    color: $ink;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid $athens-dark;
    font-size: 12.5px;
    color: rgba($ink, 0.6);
    flex-wrap: wrap;
    gap: 16px;
  }

  .social {
    display: flex;
    gap: 20px;
  }
</style>
