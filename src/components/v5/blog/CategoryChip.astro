---
import { CATEGORIES } from './categories.js';

interface Props {
  slug: keyof typeof CATEGORIES;
  size?: 'sm' | 'lg';
}

const { slug, size = 'sm' } = Astro.props;
const cat = CATEGORIES[slug];
---

{cat && (
  <span
    class={`chip chip-${size}`}
    style={`color: ${cat.color}; background: ${cat.color}26;`}
  >
    {cat.label}
  </span>
)}

<style>
  .chip {
    display: inline-block;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }
  .chip-sm {
    padding: 4px 10px;
    font-size: 11.5px;
  }
  .chip-lg {
    padding: 5px 12px;
    font-size: 12px;
  }
</style>
