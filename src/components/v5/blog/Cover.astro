---
// Blog post cover — renders a real photo when cover.image is set, otherwise
// falls back to the procedural gradient + ring pattern placeholder.

interface Props {
  cover: {
    image?: string;
    caption: string;
    hideCaption?: boolean;
    palette1?: string;
    palette2?: string;
    palette3?: string;
    accent?: string;
  };
  height?: number;
  patternId?: string;
}

const { cover, height = 240, patternId } = Astro.props;

const id = patternId ??
  `cover-${cover.caption.length}-${(cover.accent ?? '#087736').replace('#', '')}`;
---

<div
  class="cover"
  style={cover.image
    ? `--h:${height}px;`
    : `--h:${height}px; background: linear-gradient(135deg, ${cover.palette1} 0%, ${cover.palette2} 55%, ${cover.palette3} 100%);`}
>
  {cover.image ? (
    <img src={cover.image} alt={cover.caption} class="photo" />
  ) : (
    <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 400 240" class="rings">
      <defs>
        <pattern id={id} width="36" height="36" patternUnits="userSpaceOnUse">
          <circle cx="18" cy="18" r="16" fill="none" stroke={cover.accent} stroke-width="0.7" />
        </pattern>
      </defs>
      <rect width="400" height="240" fill={`url(#${id})`} />
    </svg>
  )}
  {!cover.hideCaption && <div class="caption">{cover.caption}</div>}
</div>

<style lang="scss">
  @use '../../../styles/v5/tokens' as *;

  .cover {
    position: relative;
    width: 100%;
    height: var(--h);
    border-radius: 10px;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .rings {
    position: absolute;
    inset: 0;
    opacity: 0.22;
  }

  .caption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 11px;
    color: rgba($rhino, 0.72);
    max-width: 75%;
    line-height: 1.35;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.1px;
  }
</style>
