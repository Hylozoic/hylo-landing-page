---
// Source: design_handoff_v5/design/variation-e.jsx (VE_Values + VE_PartnerLogos).
// Static — no JS. Partner logos marquee is a pure CSS keyframe animation.
// Logos are wordmark-style placeholders rendered inline; replace with real
// brand SVGs when they land.

const STATS = [
  { big: 'MIT',  label: 'Open source · on GitHub' },
  { big: 'Ø',    label: 'Ads ever placed' },
  { big: '100%', label: 'Your data stays yours' },
  { big: '2026', label: 'Pizzigati Prize · NTEN' },
];
---

<section class="values">
  <div class="container">
    <div class="eyebrow">A Quiet Flex</div>
    <h2 class="headline">
      Built as a <span class="accent">commons.</span> Owned by no one.
      Stewarded by <span class="accent">everyone.</span>
    </h2>

    <div class="lede-grid">
      <p class="lede">
        Hylo is open source, community-governed, and funded by the people who use it
        — not by ads, data sales, or venture capital. Your data belongs to you.
        Your community belongs to itself.
      </p>
      <p class="punch">
        We're building technology that serves coordination,
        <span class="accent">not extraction.</span>
      </p>
    </div>

    <div class="ctas">
      <a href="/get-involved" class="cta cta-primary">
        <span>Join Building Hylo</span>
        <span class="cta-meta">1,000+ builders</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
      <a href="https://github.com/Hylozoic/hylo-evo" target="_blank" rel="noopener noreferrer"
        class="cta cta-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.1.39-2 1.03-2.7-.1-.26-.45-1.28.1-2.67 0 0 .84-.27 2.75 1.03a9.52 9.52 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.39.2 2.41.1 2.67.64.7 1.03 1.6 1.03 2.7 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
        </svg>
        <span>GitHub</span>
        <svg width="12" height="12" viewBox="0 0 10 10" fill="none" stroke="currentColor"
          stroke-width="1.5" style="opacity:0.6" aria-hidden="true">
          <path d="M3 7L7 3" /><path d="M4 3h3v3" />
        </svg>
      </a>
    </div>

    <div class="stats">
      {STATS.map((s, i) => (
        <div class={`stat ${i < 3 ? 'stat-divider' : ''}`}>
          <div class="stat-big">{s.big}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="contrib">
      <span class="contrib-num">800 individual contributors,</span>
      and material support from
      <span class="contrib-num">18+ organizations.</span>
    </div>
  </div>

  {/* Partner logos marquee — full-bleed, escapes the .container */}
  <div class="rail">
    <div class="rail-track">
      {/* Set duplicated for seamless loop */}
      {Array.from({ length: 2 }).map(() => (
        <>
          <div class="logo">
            <div class="logo-stack">
              <div class="zu-coop">CO<span class="zu-dash">–</span>OP</div>
              <div class="zu-name">ZEBRAS UNITE</div>
            </div>
          </div>
          <div class="logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3c4 4 4 10 0 14-4-4-4-10 0-14Z" /><path d="M12 17v4" />
            </svg>
            <div class="logo-stack">
              <div class="bn-name">BIONUTRIENT</div>
              <div class="bn-sub">FOOD ASSOCIATION</div>
            </div>
          </div>
          <div class="logo new-public">
            New<span class="np-roman">_</span> Public
          </div>
          <div class="logo open-team">
            Open<span class="ot-team">TEAM</span>
          </div>
          <div class="logo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.3">
              {Array.from({ length: 8 }).map((_, i) => {
                const a = (i * Math.PI) / 4;
                return (
                  <line x1="12" y1="12" x2={12 + 10 * Math.cos(a)} y2={12 + 10 * Math.sin(a)} />
                );
              })}
            </svg>
            <div class="pi-name">PACIFIC INTEGRAL</div>
          </div>
          <div class="logo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.2">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a16 16 0 0 1 0 20M12 2a16 16 0 0 0 0 20" />
            </svg>
            <div class="logo-stack pha">
              <div>PLANETARY</div>
              <div>HEALTH</div>
              <div class="pha-sub">ALLIANCE</div>
            </div>
          </div>
          <div class="logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.2">
              {Array.from({ length: 12 }).map((_, i) => (
                <line x1="12" y1="12"
                  x2={12 + 10 * Math.cos(i * Math.PI / 6)}
                  y2={12 + 10 * Math.sin(i * Math.PI / 6)} />
              ))}
            </svg>
            <div class="logo-stack">
              <div class="rn-name">REGEN</div>
              <div class="rn-sub">NETWORK</div>
            </div>
          </div>
          <div class="logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.6">
              <circle cx="12" cy="12" r="10" />
              <path d="M4 12h16M8 7l8 10M16 7L8 17" />
            </svg>
            <div class="terran">TERRAN</div>
          </div>
          <div class="logo holochain">
            <span class="hc-text">HOL</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.4">
              <circle cx="12" cy="12" r="6" />
              <circle cx="12" cy="12" r="2" fill="currentColor" />
            </svg>
            <span class="hc-text">CHAIN</span>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../../styles/v5/tokens' as *;

  $values-accent: #9BC9B1;
  $logo-color: rgba(255, 255, 255, 0.72);

  .values {
    background: $ink;
    padding: 112px 0 96px;
    font-family: $font-sans;
    color: #fff;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .eyebrow {
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: $values-accent;
    margin-bottom: 24px;
  }

  .headline {
    font-size: 56px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -1.6px;
    line-height: 1.02;
    margin: 0;
    text-wrap: balance;
    max-width: 1000px;
  }

  .accent {
    color: $values-accent;
  }

  .lede-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    margin-top: 48px;
  }

  .lede {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .punch {
    font-size: 22px;
    line-height: 1.45;
    color: #fff;
    margin: 0;
    font-weight: 500;
    text-wrap: pretty;
  }

  .ctas {
    margin-top: 40px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta {
    height: 52px;
    padding: 0 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .cta-primary {
    border: none;
    background: $values-accent;
    color: $ink;
  }

  .cta-meta {
    font-size: 12px;
    opacity: 0.65;
    font-weight: 500;
  }

  .cta-secondary {
    padding: 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff;
  }

  .stats {
    margin-top: 80px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stat {
    padding: 32px 20px 0;
  }

  .stat-divider {
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stat-big {
    font-size: 60px;
    font-weight: 700;
    color: $values-accent;
    letter-spacing: -2.2px;
    line-height: 1;
  }

  .stat-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
    margin-top: 14px;
    line-height: 1.4;
  }

  .contrib {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 26px;
    line-height: 1.35;
    color: #fff;
    font-weight: 500;
    text-wrap: balance;
    max-width: 820px;
  }

  .contrib-num {
    color: $values-accent;
    font-weight: 700;
  }

  // ── Logo marquee ────────────────────────────────────────────
  .rail {
    margin-top: 56px;
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: 24px;
    mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  @keyframes v5-logo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .rail-track {
    display: flex;
    align-items: center;
    gap: 72px;
    width: max-content;
    animation: v5-logo-scroll 60s linear infinite;
  }

  .logo {
    flex: none;
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: $logo-color;
    opacity: 0.82;
    filter: grayscale(0.2);
  }

  .logo-stack {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  // Zebras Unite Co-op
  .zu-coop {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .zu-dash {
    color: #E8A87C;
  }
  .zu-name {
    font-size: 8.5px;
    letter-spacing: 3px;
    margin-top: 3px;
    font-weight: 600;
  }

  // Bionutrient
  .bn-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  .bn-sub {
    font-size: 9px;
    letter-spacing: 1.5px;
    margin-top: 3px;
  }

  // New_ Public
  .new-public {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
    font-family: serif;
    font-style: italic;
  }
  .np-roman {
    font-style: normal;
  }

  // OpenTEAM
  .open-team {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
  }
  .ot-team {
    color: #6BCB6B;
  }

  // Pacific Integral
  .pi-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  // PHA
  .pha {
    line-height: 1;

    & > div {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
      margin-top: 2px;

      &:first-child { margin-top: 0; }
    }
  }
  .pha-sub {
    font-size: 8.5px !important;
    letter-spacing: 2px !important;
    font-weight: 400 !important;
  }

  // Regen Network
  .rn-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .rn-sub {
    font-size: 9px;
    letter-spacing: 2.5px;
    margin-top: 3px;
  }

  // Terran
  .terran {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 2px;
  }

  // Holochain
  .hc-text {
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 5px;
  }

  // ── Tablet portrait and below ────────────────────────────────
  @media (max-width: 880px) {
    .values { padding: 80px 0 72px; }
    .container { padding: 0 24px; }
    .headline { font-size: 38px; letter-spacing: -1.2px; }
    .lede-grid { grid-template-columns: 1fr; gap: 28px; margin-top: 36px; }
    .punch { font-size: 19px; }
    .stats { grid-template-columns: 1fr 1fr; margin-top: 56px; }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(1), .stat:nth-child(2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      padding-bottom: 28px;
    }
    .stat:nth-child(3), .stat:nth-child(4) { padding-top: 28px; }
    .stat-big { font-size: 48px; }
    .contrib { margin-top: 56px; font-size: 22px; }
    .rail { margin-top: 40px; }
  }

  @media (max-width: 480px) {
    .headline { font-size: 32px; }
    .stats { grid-template-columns: 1fr; }
    .stat-divider { border-right: none; }
    .stat:nth-child(n) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      padding: 24px 0;
    }
    .stat:last-child { border-bottom: none; }
    .ctas { flex-direction: column; align-items: stretch; }
    .cta { justify-content: center; }
  }
</style>
