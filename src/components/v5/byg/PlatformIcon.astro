---
// Inline SVG icon set for the Bring-Your-Group platform comparisons.
// Source: design_handoff_v5/design/v5-bring-your-group.jsx (PlatformIcon).
interface Props {
  kind: 'fb' | 'chat' | 'hash' | 'ring' | 'circle' | 'doc';
  size?: number;
}
const { kind, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 'fb'     && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M14 8h-1.5A1.5 1.5 0 0 0 11 9.5V12M9 12h5" /><path d="M12 12v8" /></>)}
  {kind === 'chat'   && (<path d="M4 5h16v11H8l-4 4V5z" />)}
  {kind === 'hash'   && (<path d="M5 9h14M5 15h14M10 4l-2 16M16 4l-2 16" />)}
  {kind === 'ring'   && (<><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></>)}
  {kind === 'circle' && (<circle cx="12" cy="12" r="8" />)}
  {kind === 'doc'    && (<><path d="M7 3h8l4 4v14H7z" /><path d="M14 3v5h5M10 13h6M10 17h6M10 9h2" /></>)}
</svg>
