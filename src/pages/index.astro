---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/v5/sections/Hero.jsx';
import FeaturedGroups from '../components/v5/sections/FeaturedGroups.jsx';
import Journey from '../components/v5/sections/Journey.jsx';
import Map from '../components/v5/sections/Map.astro';
import Toolkit from '../components/v5/sections/Toolkit.jsx';
import Values from '../components/v5/sections/Values.astro';
import Invitation from '../components/v5/sections/Invitation.jsx';
---

