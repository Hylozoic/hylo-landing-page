  }
  .join-form-h {
    font-size: 16px;
    font-weight: 600;
    color: $rhino;
    margin-bottom: 14px;
  }

  /* form */
  .rr-form {
    background: #fff;
    border: 1px solid $athens-dark;
    border-radius: 6px;
    padding: 28px;
