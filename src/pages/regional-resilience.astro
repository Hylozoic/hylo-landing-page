    margin-top: 10px;
    font-size: 19px;
    font-weight: 600;
    color: $rhino;
  }
  .arc-body {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba($rhino, 0.7);
    text-wrap: pretty;
  }

  /* ── 5 · Good fit ────────────────────────────────────────── */
  .fit {
    background: $athens-gray;
    padding: 88px 40px;
    font-family: $font-sans;
    color: $rhino;
  }
  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .fit-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fit-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;

    svg { flex: none; margin-top: 2px; }
    span {
      font-size: 15px;
      line-height: 1.55;
      color: rgba($rhino, 0.82);
      text-wrap: pretty;
    }
  }
  .fit-card {
    background: #fff;
    border-radius: 6px;
    padding: 32px;
    border: 1px solid $athens-dark;
