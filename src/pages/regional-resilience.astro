  .fit-q-num {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: $forest-light;
    color: $forest;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── 6 · Join ────────────────────────────────────────────── */
  .join {
    background: #fff;
    padding: 88px 40px;
    font-family: $font-sans;
    color: $rhino;
  }
  .join-grid {
    display: grid;
    grid-template-columns: 40fr 55fr;
    gap: 56px;
    align-items: start;
  }
  .join-aside {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .join-card {
    background: $athens-gray;
    border: 1px solid $athens-dark;
    border-radius: 6px;
    padding: 22px;
  }
  .join-card-h { font-size: 16px; font-weight: 600; color: $rhino; }
  .join-card-p {
    margin: 6px 0 14px;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba($rhino, 0.7);
  }
  .join-email {
    font-size: 14px;
    line-height: 1.6;
    color: rgba($rhino, 0.6);

    a { color: $forest; font-weight: 500; text-decoration: none; }
