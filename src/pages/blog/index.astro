---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/v5/blog/Cover.astro';
import CategoryChip from '../../components/v5/blog/CategoryChip.astro';
import PostFilter from '../../components/v5/blog/PostFilter.jsx';
import { CATEGORY_KEYS } from '../../components/v5/blog/categories.js';

// Source: design_handoff_v5/design/v5-blog.jsx (BlogIndexPage).
// Posts come from the Astro Content Collection backed by Keystatic
// (src/content/blog/*.mdx). One featured post powers the hero; the rest
// fill the filterable grid.

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest     = posts.filter((p) => p.id !== featured?.id);

// Counts per category (plus 'all') so the React filter island can render
// numbers without re-deriving them client-side.
const counts = { all: rest.length };
for (const k of CATEGORY_KEYS) counts[k] = 0;
for (const p of rest) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;

// Force UTC so a 2026-04-18 frontmatter date doesn't shift to "April 17" in
// timezones west of UTC.
const fmtDate = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="Hylo — The blog">
  {/* ── Hero (featured post) ─────────────────────────────────── */}
  {featured && (
    <section class="hero">
      <div class="hero-inner">
        <div class="eyebrow">The Hylo blog</div>
        <h1 class="hero-title">
          Dispatches from the people building, stewarding, and using Hylo.
        </h1>
        <p class="hero-lede">
          Essays, field notes, community stories, and product updates — written
          by the team and the communities we work with.
        </p>

        <a href={`/blog/${featured.id}`} class="featured">
          <Cover cover={featured.data.cover} height={360} patternId="cover-featured" />
          <div class="featured-body">
            <CategoryChip slug={featured.data.category} size="lg" />
            <h2 class="featured-title">{featured.data.title}</h2>
            <p class="featured-excerpt">{featured.data.excerpt}</p>
            <div class="meta">
              <span class="meta-author">{featured.data.author.name}</span>
              <span class="dot"></span>
              <span>{fmtDate(featured.data.date)}</span>
              <span class="dot"></span>
              <span>{featured.data.readTime}</span>
            </div>
            <div class="read-cta">Read the essay <span class="arr">→</span></div>
          </div>
        </a>
      </div>
    </section>
  )}

  {/* ── Filter + grid ────────────────────────────────────────── */}
  <section class="grid-section">
    <div class="grid-inner">
      <div class="rule"></div>

      <PostFilter counts={counts} client:load />

      {rest.length === 0 ? (
        <div id="blog-empty" class="empty">No posts yet.</div>
      ) : (
        <>
          <div id="blog-empty" class="empty" style="display: none;">No posts in this category yet.</div>
          <div class="card-grid">
            {rest.map((p, i) => (
              <a
                href={`/blog/${p.id}`}
                data-category={p.data.category}
                class="post-card"
              >
                <Cover cover={p.data.cover} height={200} patternId={`cover-${i}`} />
                <div class="post-body">
                  <CategoryChip slug={p.data.category} />
                  <h3 class="post-title">{p.data.title}</h3>
                  <p class="post-excerpt">
                    {p.data.excerpt.length > 140
                      ? p.data.excerpt.slice(0, 140) + '…'
                      : p.data.excerpt}
                  </p>
                  <div class="meta">
                    <span class="meta-author">{p.data.author.name}</span>
                    <span class="dot"></span>
                    <span>{fmtDate(p.data.date)}</span>
                    <span class="dot"></span>
                    <span>{p.data.readTime}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  {/* ── Newsletter ───────────────────────────────────────────── */}
  <section class="news">
    <div class="news-inner">
      <h2 class="news-h">Get the monthly dispatch</h2>
      <p class="news-lede">
        One email a month. Essays, product notes, community stories, and the
        occasional invitation. No marketing copy, no tracking, no spam.
      </p>
      <form class="news-form" onsubmit="event.preventDefault();">
        <input type="email" required placeholder="you@yourgroup.org" class="news-input" />
        <button type="submit" class="news-cta">Subscribe</button>
      </form>
      <div class="news-foot">
        Unsubscribe anytime. We store your email and that’s it.
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../../styles/v5/tokens' as *;

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    background: $cream;
    padding: 160px 40px 40px;
    font-family: $font-sans;
    color: $rhino;
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: $forest;
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -1.1px;
    line-height: 1.05;
    margin: 0;
    color: $rhino;
    max-width: 820px;
    text-wrap: balance;
  }
  .hero-lede {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.6;
    color: rgba($rhino, 0.7);
    max-width: 640px;
    text-wrap: pretty;
  }

  .featured {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .featured-body { min-width: 0; }
  .featured-title {
    margin-top: 16px;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.9px;
    line-height: 1.1;
    color: $rhino;
    text-wrap: balance;
  }
  .featured-excerpt {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba($rhino, 0.72);
    text-wrap: pretty;
  }
  .read-cta {
    margin-top: 24px;
    color: $forest;
    font-size: 14px;
    font-weight: 600;
  }
  .arr { margin-left: 4px; }

  .meta {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: rgba($rhino, 0.55);
    flex-wrap: wrap;
  }
  .meta-author {
    font-weight: 500;
    color: rgba($rhino, 0.75);
  }
  .dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgba($rhino, 0.25);
    flex: none;
  }

  /* ── Grid ─────────────────────────────────────────────────── */
  .grid-section {
    background: #fff;
    padding: 8px 40px 96px;
    font-family: $font-sans;
    color: $rhino;
  }
  .grid-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .rule {
    border-top: 1px solid $athens-dark;
  }
  .empty {
    padding: 40px 0;
    text-align: center;
    color: rgba($rhino, 0.55);
    font-size: 15px;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .post-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform .2s ease;

    &:hover { transform: translateY(-2px); }
    &.is-hidden { display: none; }
  }
  .post-body { padding: 18px 2px 0; }
  .post-title {
    margin-top: 12px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.2;
    color: $rhino;
    text-wrap: balance;
  }
  .post-excerpt {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba($rhino, 0.65);
    text-wrap: pretty;
  }

  /* ── PostFilter island styles (the island renders bare elements) */
  :global(.filter-row) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 36px 0 28px;
  }
  :global(.filter-pill) {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1px;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s, color .15s, border-color .15s;
  }
  :global(.filter-count) {
    margin-left: 8px;
    font-size: 11px;
  }

  /* ── Newsletter ───────────────────────────────────────────── */
  .news {
    background: $athens-gray;
    padding: 60px 40px;
    font-family: $font-sans;
    color: $rhino;
  }
  .news-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .news-h {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: $rhino;
    margin: 0;
    line-height: 1.2;
  }
  .news-lede {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba($rhino, 0.68);
    text-wrap: pretty;
  }
  .news-form {
    margin-top: 24px;
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .news-input {
    min-width: 280px;
    height: 44px;
    padding: 0 16px;
    border-radius: 6px;
    border: 1px solid rgba($rhino, 0.22);
    background: #fff;
    font-size: 14px;
    color: $rhino;
    font-family: inherit;
    outline: none;
  }
  .news-cta {
    height: 44px;
    padding: 0 22px;
    border-radius: 6px;
    border: 0;
    background: $forest;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    cursor: pointer;
    font-family: inherit;
  }
  .news-foot {
    margin-top: 12px;
    font-size: 12px;
    color: rgba($rhino, 0.48);
  }

  /* ── Tablet portrait and below ──────────────────────────── */
  @media (max-width: 880px) {
    .hero { padding: 120px 24px 32px; }
    .hero-title { font-size: 32px; letter-spacing: -0.8px; }
    .hero-lede { font-size: 16px; }
    .featured {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 32px;
    }
    .featured-title { font-size: 26px; }

    .grid-section { padding: 8px 24px 72px; }
    .card-grid { grid-template-columns: 1fr; gap: 32px; }

    .news { padding: 48px 24px; }
  }
</style>
