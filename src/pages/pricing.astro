---
import Layout from '../layouts/Layout.astro';
import { tokens } from '../components/v5/tokens.js';

// Source: design_handoff_pricing_features_who_stories/pages/v5-pricing.jsx
// + specs/hylo-products-pricing-spec.md.
//
// Pure-static page (zero React islands). 9 sections: Hero, Hylo Free,
// Hylo Pro, Hylo Whitelabel, Hylo Assistant, Stewardship Support bridge,
// "How this works" essay + commons facts, comparison table, closing CTA.
//
// The handoff includes a custom dark footer for this page; we keep the
// shared light Footer (via Layout) for consistency with every other page
// on the site. Update the shared Footer separately if the team wants the
// new column items applied site-wide.

// Page-local accent colors (not in tokens since they're page-specific)
const PURPLE   = '#9883E5'; // Assistant + Blossom
const PICTON   = '#40A1DD'; // Support Call
const MOUNTAIN = '#23CC80'; // Seed

const FREE_FEATURES = [
  { name: 'Groups & subgroups',     desc: 'Nested groups, peer groups, cross-group coordination' },
  { name: 'Discussions',            desc: 'Threaded conversations with topics and tagging' },
  { name: 'Chat',                   desc: 'Real-time chat rooms within any group' },
  { name: 'Events',                 desc: 'In-person and virtual, with RSVPs and calendar sync' },
  { name: 'Requests & offers',      desc: 'Mutual support infrastructure with completion tracking' },
  { name: 'Projects',               desc: 'Coordinated work with tasks, roles, and timelines' },
  { name: 'Proposals & decisions',  desc: 'Polls, proposals, quorum, structured decision-making' },
  { name: 'Agreements & roles',     desc: 'Shared governance documents and role-based stewardship' },
  { name: 'Map & place',            desc: 'Geographic groups, member map, place-based organizing' },
  { name: 'Member directory',       desc: 'Profiles, skills, location, interests' },
  { name: 'Custom post types',      desc: 'Configure the content types your group uses' },
  { name: 'Mobile apps',            desc: 'iOS and Android, full-featured' },
  { name: 'Notifications',          desc: 'Customizable — email, push, in-app, digest' },
  { name: 'Public commons',         desc: 'Discover groups, share across the network' },
  { name: 'File sharing',           desc: '1 GB of storage for documents, images, and resources' },
  { name: 'Moderation tools',       desc: 'Flagging, steward controls, community agreements' },
  { name: 'Unlimited members',      desc: 'No cap on group size' },
  { name: 'Unlimited groups',       desc: 'Create as many groups and subgroups as you need' },
];

const PRO_CARDS = [
  { icon: 'cloud',   name: 'Expanded storage',
    desc: 'Go well beyond the free 1 GB. More space for files, images, documents, and media — share what your community needs without worrying about limits.' },
  { icon: 'play',    name: 'Video streaming',
    desc: 'Host and stream video directly within Hylo. Meetings, workshops, and community events without needing a separate platform.' },
  { icon: 'support', name: 'Priority support',
    desc: 'Faster response times from the Hylo team when your group needs help. Direct access for technical and stewardship questions.' },
  { icon: 'plug',    name: 'API access & integrations',
    desc: 'Connect Hylo to your existing tools and workflows. Build custom integrations, automate processes, and extend the platform to fit your stack.' },
];

const WL_INCLUDED = [
  'Dedicated instance under your domain',
  'Full visual customization — your brand, your themes',
  'All Hylo platform features',
  'Ongoing updates from core platform development',
  'Setup and migration support from the Hylo team',
  'Optional: custom feature development (priced separately)',
];

const ASSISTANT_CARDS = [
  { name: 'Full-context RAG across your group',
    desc: "The Assistant can search and reason across your group's entire history — posts, discussions, decisions, agreements, files. Members can ask it questions and get answers grounded in what your community has actually said and decided." },
  { name: 'Google Drive and document integration',
    desc: "Connect your group's Google Drive (and other document sources) so the Assistant can reference shared documents, meeting notes, and resources alongside Hylo content. Your group's knowledge lives in many places — the Assistant brings it together." },
  { name: 'Community health and growth guidance',
    desc: "The Assistant helps stewards understand what's working and what isn't — engagement patterns, unanswered requests, quiet members, conversations that need follow-up. Not analytics dashboards, but actionable guidance." },
  { name: 'Proactive moderation support',
    desc: 'The Assistant monitors for content that may need steward attention — potential code of conduct issues, heated conversations, flagged posts — and surfaces them to your moderation team promptly. Stewards make the decisions.' },
];

const STEWARD_TIERS = [
  { name: 'Support Call', border: PICTON,   price: '$300',           line: "A focused hour on your group's challenges" },
  { name: 'Pollination',  border: tokens.forest, price: '$2,500',    line: 'Full onboarding and launch support' },
  { name: 'Seed',         border: MOUNTAIN, price: '$100/mo',        line: 'Ongoing connection and priority support' },
  { name: 'Blossom',      border: PURPLE,   price: 'From $1,000/mo', line: 'Hands-on community building' },
];

const COMMONS_FACTS = [
  { icon: 'lock',    text: '100% open source — always' },
  { icon: 'civic',   text: '501(c)(3) non-profit — no shareholders' },
  { icon: 'recycle', text: 'Paid products fund the free platform' },
];

// Comparison: each row is [feature, freeVal, proVal, assistantVal, whitelabelVal]
// Values: true = included, false = excluded, string = text in cell
const COMPARISON = [
  { feat: 'Groups & subgroups',         vals: [true, true, true, true] },
  { feat: 'Cross-group coordination',   vals: [true, true, true, true] },
  { feat: 'Discussions & chat',         vals: [true, true, true, true] },
  { feat: 'Events',                     vals: [true, true, true, true] },
  { feat: 'Requests & offers',          vals: [true, true, true, true] },
  { feat: 'Projects',                   vals: [true, true, true, true] },
  { feat: 'Proposals & decisions',      vals: [true, true, true, true] },
  { feat: 'Governance tools',           vals: [true, true, true, true] },
  { feat: 'Map & place',                vals: [true, true, true, true] },
  { feat: 'Mobile apps',                vals: [true, true, true, true] },
  { feat: 'Unlimited members',          vals: [true, true, true, true] },
  { feat: 'Unlimited groups',           vals: [true, true, true, true] },
  { feat: 'Storage',                    vals: ['1 GB', 'Expanded', '1 GB', 'Custom'] },
  { feat: 'Video streaming',            vals: [false, true, false, true] },
  { feat: 'Priority support',           vals: [false, true, false, true] },
  { feat: 'API access',                 vals: [false, true, false, true] },
  { feat: 'AI group knowledge (RAG)',   vals: [false, false, true, 'Available'] },
  { feat: 'Document integration',       vals: [false, false, true, 'Available'] },
  { feat: 'Growth & health guidance',   vals: [false, false, true, 'Available'] },
  { feat: 'Moderation awareness',       vals: [false, false, true, 'Available'] },
  { feat: 'Custom domain',              vals: [false, false, false, true] },
  { feat: 'Custom branding',            vals: [false, false, false, true] },
  { feat: 'Dedicated instance',         vals: [false, false, false, true] },
  { feat: 'Custom development',         vals: [false, false, false, 'Available'] },
];

const COLS = [
  { name: 'Hylo Free',       price: 'Free forever',     priceColor: tokens.forest },
  { name: 'Hylo Pro',        price: '$60/mo per group', priceColor: tokens.forest },
  { name: 'Hylo Assistant',  price: '$20/mo per group', priceColor: PURPLE },
  { name: 'Hylo Whitelabel', price: '$100/mo',          priceColor: tokens.forest },
];
---

<Layout title="Hylo — Pricing">
  {/* ── 1 · Hero ────────────────────────────────────────────── */}
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">Free to use. Built to last.</h1>
      <p class="hero-lede">
        Hylo's full coordination platform is free — for every group, forever.
        Paid products exist for groups that need more capacity or hands-on
        support, and every dollar sustains an open-source commons. No trial
        periods. No feature gates. No bait and switch.
      </p>
    </div>
  </section>

  {/* ── 2 · Hylo Free ───────────────────────────────────────── */}
  <section class="prod prod-free">
    <div class="prod-inner">
      <header class="prod-head">
        <h2 class="prod-name">Hylo</h2>
        <div class="prod-price">Free forever</div>
      </header>
      <p class="one-liner">
        The full platform. Every feature that matters for community
        coordination. No credit card. No expiration.
      </p>

      <div class="feature-grid">
        {FREE_FEATURES.map((f) => (
          <div class="feature">
            <div class="feature-name">{f.name}</div>
            <div class="feature-desc">{f.desc}</div>
          </div>
        ))}
      </div>

      <p class="bottom-note">
        This isn't a free trial. It's the product. We believe coordination
        infrastructure should be accessible to every community, regardless of
        budget.
      </p>
    </div>
  </section>

  {/* ── 3 · Hylo Pro ────────────────────────────────────────── */}
  <section class="prod prod-pro">
    <div class="prod-inner">
      <header class="prod-head">
        <h2 class="prod-name">Hylo Pro</h2>
        <div class="prod-price">$60/month per group</div>
      </header>
      <div class="badge-row">
        <span class="badge badge-forest">Launching Summer 2026</span>
      </div>
      <p class="one-liner">
        For groups that need more capacity. Everything in Hylo Free, plus
        tools for organizations operating at scale.
      </p>

      <div class="pro-grid">
        {PRO_CARDS.map((c) => (
          <div class="pro-card">
            <span class="pro-icon">
              {c.icon === 'cloud' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 18a5 5 0 0 1 .5-9.96 6 6 0 0 1 11.5 1.46A4 4 0 0 1 18 18H7Z" />
                </svg>
              )}
              {c.icon === 'play' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m10 9 5 3-5 3V9Z" fill="currentColor" />
                </svg>
              )}
              {c.icon === 'support' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 14v-3a8 8 0 0 1 16 0v3" />
                  <path d="M4 14a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2Z" />
                  <path d="M20 14a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2Z" />
                  <path d="M14 19a2 2 0 0 1-2 2h-1" />
                </svg>
              )}
              {c.icon === 'plug' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 2v4M15 2v4" />
                  <path d="M5 8h14v4a7 7 0 0 1-14 0V8Z" />
                  <path d="M12 19v3" />
                </svg>
              )}
            </span>
            <div class="pro-card-name">{c.name}</div>
            <div class="pro-card-desc">{c.desc}</div>
          </div>
        ))}
      </div>

      <p class="prod-summary">
        <strong>$60/month per group.</strong> One price, every member included.
        Launching Summer 2026.
      </p>
      <div class="prod-cta">
        <a href="#waitlist-pro" class="btn">Join the Pro waitlist</a>
      </div>
    </div>
  </section>

  {/* ── 4 · Hylo Whitelabel ─────────────────────────────────── */}
  <section class="prod prod-wl">
    <div class="wl-grid">
      <div>
        <header class="prod-head">
          <h2 class="prod-name">Hylo Whitelabel</h2>
          <div class="prod-price">$100/month</div>
        </header>
        <div class="badge-row">
          <span class="badge badge-forest">Launching Summer 2026</span>
        </div>

        <div class="wl-prose">
          <p>
            Some organizations need Hylo's coordination infrastructure under
            their own brand — their domain, their identity, their experience.
            Hylo Whitelabel is a dedicated deployment of the platform,
            configured for your organization.
          </p>
          <p>
            Your community gets the full power of Hylo's coordination tools —
            groups, governance, mutual support, map, cross-group coordination —
            inside an environment that looks and feels entirely like yours.
            Your brand, your colors, your domain.
          </p>
          <p>
            Because Hylo is open source, whitelabel deployments benefit from
            ongoing platform development while maintaining full independence.
            You're not locked into a vendor relationship — you're building on
            a commons.
          </p>
        </div>

        <div class="wl-included">
          {WL_INCLUDED.map((it) => (
            <div class="wl-item">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="check-mini" aria-hidden="true">
                <path d="m2 6 3 3 5-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{it}</span>
            </div>
          ))}
        </div>
      </div>

      <aside class="wl-card">
        <div class="wl-card-price">$100/month.</div>
        <div class="wl-card-line">Your brand. Your domain. Full platform.</div>
        <div class="wl-card-line">
          Launching Summer 2026. Join the waitlist to reserve your deployment.
        </div>
        <a href="#waitlist-whitelabel" class="btn btn-block">Join the Whitelabel waitlist</a>
        <div class="wl-card-help">
          Questions?
          {' '}<a href="mailto:hello@hylo.com" class="wl-mailto">hello@hylo.com</a>
        </div>
      </aside>
    </div>
  </section>

  {/* ── 5 · Hylo Assistant ──────────────────────────────────── */}
  <section class="prod prod-assistant">
    <div class="prod-inner">
      <header class="prod-head">
        <h2 class="prod-name">Hylo Assistant</h2>
        <div class="prod-price prod-price-purple">$20/month per group</div>
      </header>
      <div class="badge-row">
        <span class="badge badge-purple">Coming soon</span>
      </div>
      <p class="one-liner">
        An AI steward that knows your group — its history, its people, its
        purpose — and helps you take care of it.
      </p>

      <div class="ai-grid">
        <div class="ai-prose">
          <p>
            Every group steward knows the feeling: a new member joins and
            nobody welcomes them. A request goes unanswered for three days.
            A conversation that needed moderation slipped by. Someone posted
            something harmful at 2am and it sat there until morning.
          </p>
          <p>
            Stewardship is the work that makes communities live or die, and
            most of it is invisible, repetitive, and easy to fall behind on.
            The Hylo Assistant is designed to carry that load alongside your
            stewards — not replacing human judgment, but making sure nothing
            falls through the cracks.
          </p>
          <p>
            The Assistant has full context on your group: every conversation,
            every decision, every agreement, every member's history. It uses
            that context to help stewards stay on top of what matters,
            surface what needs attention, and give every member a way to
            navigate the group's collective knowledge.
          </p>
        </div>

        <div class="ai-cards">
          {ASSISTANT_CARDS.map((c) => (
            <div class="ai-card">
              <div class="ai-card-name">{c.name}</div>
              <div class="ai-card-desc">{c.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="values-box">
        <strong>How this aligns with our values:</strong>{' '}
        The Hylo Assistant works for your group, not for Hylo. It doesn't
        optimize for engagement, doesn't track behavior for advertising, and
        doesn't make decisions on behalf of your community. It's a tool that
        helps stewards do their work more effectively — the same work they'd
        do manually, with better context and fewer blind spots. All AI
        interactions are transparent to stewards. Your group's data stays
        within your group. And the Assistant follows the same agreements
        your community does.
      </div>

      <p class="prod-summary">
        <strong>$20/month per group.</strong> Add the Assistant to any Hylo
        group — Free, Pro, or Whitelabel. Join the waitlist to be notified
        when it launches.
      </p>
      <div class="prod-cta">
        <a href="#waitlist-assistant" class="btn btn-purple">Join the Assistant waitlist</a>
      </div>
    </div>
  </section>

  {/* ── 6 · Stewardship support bridge ──────────────────────── */}
  <section class="bridge">
    <div class="bridge-inner">
      <h2 class="section-h">Need hands-on help building your community?</h2>
      <p class="bridge-prose">
        Technology alone doesn't make a community thrive — stewardship does.
        Hylo's team offers direct support for groups at every stage:
        onboarding workshops, strategy sessions, ongoing coaching, and even
        dedicated community management. We've spent years learning what makes
        online communities come alive, and we bring that experience to your
        group.
      </p>

      <div class="tier-row">
        {STEWARD_TIERS.map((t) => (
          <div class="tier" style={`border-left-color: ${t.border};`}>
            <div class="tier-name">{t.name}</div>
            <div class="tier-price">{t.price}</div>
            <div class="tier-line">{t.line}</div>
          </div>
        ))}
      </div>

      <a href="/stewardship-support" class="bridge-link">
        Learn more about stewardship support →
      </a>
    </div>
  </section>

  {/* ── 7 · How this works ──────────────────────────────────── */}
  <section class="commons">
    <div class="commons-inner">
      <h2 class="section-h">How this works</h2>
      <div class="commons-prose">
        <p>
          Hylo is a non-profit commons. There are no investors expecting
          returns. There are no shareholders demanding growth. The platform
          stays free because paid products and community contributions cover
          the cost of development, hosting, and the small team that maintains
          everything.
        </p>
        <p>
          When a group pays for Pro, Assistant, Whitelabel, or stewardship
          support, that money goes to three places: compensating the people
          who build and maintain Hylo, funding platform development that
          benefits every group (including the free ones), and keeping the
          infrastructure running. That's it.
        </p>
        <p>
          This is the model. It's not complicated. It's just uncommon —
          because most platforms are built to extract value, and Hylo is
          built to sustain a commons.
        </p>
      </div>

      <div class="facts">
        {COMMONS_FACTS.map((f, i) => (
          <div class={`fact ${i < COMMONS_FACTS.length - 1 ? 'fact-divider' : ''}`}>
            <span class="fact-icon">
              {f.icon === 'lock' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5" y="11" width="14" height="9" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
              )}
              {f.icon === 'civic' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 21h18" />
                  <path d="M5 21V10l7-5 7 5v11" />
                  <path d="M9 21v-6h6v6" />
                </svg>
              )}
              {f.icon === 'recycle' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 7h6l-2-2" />
                  <path d="m7 7-3 5 3 5" />
                  <path d="M17 17h-6l2 2" />
                  <path d="m17 17 3-5-3-5" />
                </svg>
              )}
            </span>
            <span>{f.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── 8 · Comparison table ────────────────────────────────── */}
  <section class="cmp">
    <div class="cmp-inner">
      <div class="cmp-eyebrow">Compare options</div>
      <div class="cmp-scroll">
        <table>
          <thead>
            <tr>
              <th></th>
              {COLS.map((c) => (
                <th>
                  <div class="cmp-name">{c.name}</div>
                  <div class="cmp-price" style={`color: ${c.priceColor};`}>{c.price}</div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {COMPARISON.map((row, i) => (
              <tr class={i % 2 ? 'even' : ''}>
                <td class="row-label">{row.feat}</td>
                {row.vals.map((v) => (
                  <td>
                    {v === true ? (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="cell-check" aria-label="Included">
                        <path d="m3 8 3.5 3.5L13 5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    ) : v === false ? (
                      <span class="cell-no">—</span>
                    ) : (
                      <span class="cell-text">{v}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ── 9 · Closing CTA ─────────────────────────────────────── */}
  <section class="closing">
    <div class="closing-inner">
      <h2 class="closing-h">Start for free. Grow from there.</h2>
      <p class="closing-prose">
        Every group on Hylo starts with the full platform at no cost. If you
        need more capacity or hands-on support down the road, we'll be here.
        For now — bring your group and see what becomes possible.
      </p>
      <div class="closing-cta">
        <a href="/bring-your-group" class="btn">Create your group — free</a>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../styles/v5/tokens' as *;

  $purple: #9883E5;

  /* ── shared ──────────────────────────────────────────────── */
  .section-h {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: $rhino;
    margin: 0;
    line-height: 1.2;
  }
  .one-liner {
    font-size: 16px;
    line-height: 1.6;
    margin: 12px 0 0;
    color: rgba($rhino, 0.65);
    text-wrap: pretty;
  }
  .prod-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .prod-name {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.6px;
    color: $rhino;
    margin: 0;
    line-height: 1.2;
  }
  .prod-price {
    font-size: 18px;
    font-weight: 500;
    color: $forest;
    letter-spacing: -0.2px;
  }
  .prod-price-purple { color: $purple; }
  .badge-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 6px;
  }
  .badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }
  .badge-forest { background: rgba($forest, 0.85); }
  .badge-purple { background: $purple; }

  .btn {
    display: inline-block;
    text-align: center;
    background: $forest;
    color: #fff;
    padding: 0 24px;
    height: 40px;
    line-height: 40px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }
  .btn-purple { background: $purple; }
  .btn-block {
    display: block;
    width: 100%;
  }

  /* ── 1 · Hero ────────────────────────────────────────────── */
  .hero {
    background: $cream;
    padding: 160px 40px 60px;
    font-family: $font-sans;
    color: $rhino;
  }
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-title {
    font-size: 52px;
    font-weight: 700;
