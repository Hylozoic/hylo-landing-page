# Landing-page analytics (see src/components/Analytics.astro).
#
# Both are OPTIONAL and only load in production builds. Leaving either blank
# disables that tool. Set these as environment variables in the Netlify site
# settings (Site configuration → Environment variables), not just locally.
#
# The PUBLIC_ prefix is required by Astro to expose a value to client-side code.

# Plausible: the domain exactly as registered in your Plausible account
# (e.g. "hylo.com"). Powers marketing metrics — traffic, sources, UTM
# campaigns, outbound-link clicks. Cookieless; no consent banner needed.
PUBLIC_PLAUSIBLE_DOMAIN=

# Mixpanel: the project token for the project you want landing-page events in.
# Use the SAME project as the app if you want a unified acquisition → signup →
# activation funnel (the signup links carry the Mixpanel distinct_id so the app
# can identify() the same visitor).
PUBLIC_MIXPANEL_TOKEN=
